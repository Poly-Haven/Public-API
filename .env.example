# Firestore service account (the private key keeps its literal \n escapes)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Which node this is, reported by /ping. Any short label. admin's clear_cache fan-out logs it.
NODE_ID=

# REQUIRED (server.ts refuses to start if it is unset or empty, as it is for every variable marked so below).
# Shared secret for the privileged endpoints: /track_search, /dl_track, /gallery_click, /clear_cache, /debug/:state
DL_KEY=

# Early-access key
EA_KEY=
# REQUIRED. The master secret for POST /v2/create_key
API_KEY_MASTER=

# Set to 1 to refuse (429) keyed /v2 requests over the per-key limit. Unset, they are only logged ("[KEY RATE]").
KEY_RATE_LIMIT_ENFORCE=

# Patreon / Superhive webhooks and supporter lookups. REQUIRED: PATREON_HOOK_SECRET, PATRON_INFO_KEY and
# SUPERHIVE_KEY (the last is part of the webhook's URL path, /v2/superhive_<key>).
PATREON_SECRET=
PATREON_HOOK_SECRET=
PATRON_INFO_KEY=
SUPERHIVE_KEY=
DISCORD_PATRON_HOOK=

# Cloudflare. ZONE covers polyhaven.com + api.polyhaven.com (one shared zone), and ZONE_ORG is
# dl.polyhaven.org only.
CLOUDFLARE_ZONE=
CLOUDFLARE_ZONE_ORG=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_EMAIL=

# Workers AI, for /search query embedding. The account id is not a secret (it is in every dashboard
# URL). The token needs Account -> Workers AI -> Read. Without both, /search returns 503 and callers
# fall back to their own keyword matching.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Translation progress for /translation_progress
I18NEXUS_API_KEY=

NODE_ENV=production
