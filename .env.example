# Firestore service account (the private key keeps its literal \n escapes)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Which node this is, reported by /ping. Any short label. admin's clear_cache fan-out logs it.
NODE_ID=

# Shared secret for the privileged endpoints: /track_search, /clear_cache, /debug/:state
DL_KEY=

# Early-access key, and the master key that bypasses per-key validation on /v2
EA_KEY=
API_KEY_MASTER=

# Patreon / Superhive webhooks and supporter lookups
PATREON_SECRET=
PATREON_HOOK_SECRET=
PATRON_INFO_KEY=
SUPERHIVE_KEY=
DISCORD_PATRON_HOOK=

# Cloudflare. ZONE covers polyhaven.com + api.polyhaven.com (one shared zone), and ZONE_ORG is
# dl.polyhaven.org only.
CLOUDFLARE_ZONE=
CLOUDFLARE_ZONE_ORG=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_EMAIL=

# Workers AI, for /search query embedding. The account id is not a secret (it is in every dashboard
# URL). The token needs Account -> Workers AI -> Read. Without both, /search returns 503 and callers
# fall back to their own keyword matching.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Translation progress for /translation_progress
I18NEXUS_API_KEY=

NODE_ENV=production
